    {
      "id": "node-query-statistics",
      "name": "Query Statistics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-680, 300],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COUNT(*) FILTER (\n    WHERE appointment_date = (NOW() AT TIME ZONE 'Asia/Kolkata')::DATE\n  )::int AS today_total,\n  COUNT(*) FILTER (\n    WHERE appointment_date = (NOW() AT TIME ZONE 'Asia/Kolkata')::DATE\n    AND status = 'SCHEDULED'\n  )::int AS today_scheduled,\n  COUNT(*) FILTER (\n    WHERE appointment_date = (NOW() AT TIME ZONE 'Asia/Kolkata')::DATE\n    AND status = 'COMPLETED'\n  )::int AS today_completed,\n  COUNT(*) FILTER (\n    WHERE appointment_date = (NOW() AT TIME ZONE 'Asia/Kolkata')::DATE\n    AND status = 'CANCELLED'\n  )::int AS today_cancelled\nFROM appointments;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "POSTGRES_CRED_ID", "name": "Hospital Postgres" }
      }
    },
    {
