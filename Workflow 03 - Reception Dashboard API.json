    {
      "id": "node-update-status",
      "name": "Update Appointment Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-240, 400],
      "onError": "continueErrorOutput",
      "alwaysOutputData": true,
      "notes": "Idempotent for same-status; only matches rows currently SCHEDULED or already equal to the requested status. Cross-terminal transitions return zero rows.",
      "notesInFlow": false,
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE appointments\nSET\n  status = $2,\n  updated_at = CASE\n    WHEN status = $2 THEN updated_at\n    ELSE NOW()\n  END\nWHERE appointment_id = $1\n  AND (status = 'SCHEDULED' OR status = $2)\nRETURNING appointment_id, status;",
        "options": {
          "queryReplacement": "={{ [ $json.appointment_id, $json.new_status ] }}"
        }
      },
      "credentials": {
