    {
      "id": "node-query-patients",
      "name": "Query Patients",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-680, 140],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  p.patient_id,\n  p.patient_name,\n  p.whatsapp_number,\n  COALESCE(\n    json_agg(\n      json_build_object(\n        'appointment_id', a.appointment_id,\n        'start_time', a.start_time,\n        'status', a.status,\n        'doctor_name', d.doctor_name\n      )\n      ORDER BY a.start_time DESC\n    ) FILTER (WHERE a.appointment_id IS NOT NULL),\n    '[]'::json\n  ) AS appointment_history\nFROM patients p\nLEFT JOIN appointments a ON a.patient_id = p.patient_id\nLEFT JOIN doctors d ON d.doctor_id = a.doctor_id\nGROUP BY p.patient_id, p.patient_name, p.whatsapp_number\nORDER BY p.patient_name NULLS LAST;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "POSTGRES_CRED_ID", "name": "Hospital Postgres" }
      }
    },
    {
