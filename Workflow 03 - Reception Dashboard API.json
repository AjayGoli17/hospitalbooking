    {
      "id": "node-validate-filters",
      "name": "Validate Filters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, -260],
      "notes": "Validates date = a real YYYY-MM-DD calendar date (or null), doctor_id = integer or null, status in enum or null. Rejects malformed calendar dates like 2026-02-30 or 2026-13-01 without relying on PostgreSQL to catch them.",
      "notesInFlow": false,
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst validStatuses = ['SCHEDULED', 'COMPLETED', 'CANCELLED'];\nlet valid = true;\n\nfunction isValidCalendarDate(dateStr) {\n  const match = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(dateStr);\n  if (!match) return false;\n  const year = parseInt(match[1], 10);\n  const month = parseInt(match[2], 10);\n  const day = parseInt(match[3], 10);\n  if (month < 1 || month > 12) return false;\n  if (day < 1) return false;\n  const isLeapYear = (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);\n  const daysInMonth = [31, isLeapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  if (day > daysInMonth[month - 1]) return false;\n  return true;\n}\n\nif (item.date !== null && !isValidCalendarDate(item.date)) valid = false;\nif (item.doctor_id !== null && !Number.isInteger(item.doctor_id)) valid = false;\nif (item.status !== null && !validStatuses.includes(item.status)) valid = false;\n\nreturn [{ json: { ...item, _filtersValid: valid } }];"
      }
    },
    {
      "id": "node-filters-valid",
      "name": "Filters Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-460, -260],
      "notesInFlow": false,
      "notes": "TRUE = proceed to query. FALSE = 400 Bad Request.",
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{$json._filtersValid}}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-err-bad-filters",
      "name": "Error - Bad Request (Filters)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
