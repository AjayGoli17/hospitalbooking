      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-680, -420],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  a.appointment_id,\n  a.start_time,\n  a.end_time,\n  a.status,\n  d.doctor_id,\n  d.doctor_name,\n  p.patient_id,\n  p.patient_name,\n  p.whatsapp_number\nFROM appointments a\nJOIN doctors d ON d.doctor_id = a.doctor_id\nJOIN patients p ON p.patient_id = a.patient_id\nWHERE a.appointment_date = (NOW() AT TIME ZONE 'Asia/Kolkata')::DATE\nORDER BY a.start_time;",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "POSTGRES_CRED_ID", "name": "Hospital Postgres" }
      }
    },
