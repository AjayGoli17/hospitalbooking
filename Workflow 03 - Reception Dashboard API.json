    {
      "id": "node-query-appointments",
      "name": "Query Filtered Appointments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-240, -320],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  a.appointment_id,\n  a.start_time,\n  a.end_time,\n  a.status,\n  d.doctor_id,\n  d.doctor_name,\n  p.patient_id,\n  p.patient_name,\n  p.whatsapp_number\nFROM appointments a\nJOIN doctors d ON d.doctor_id = a.doctor_id\nJOIN patients p ON p.patient_id = a.patient_id\nWHERE ($1::date IS NULL OR a.appointment_date = $1::date)\n  AND ($2::int IS NULL OR a.doctor_id = $2::int)\n  AND ($3::text IS NULL OR a.status = $3::text)\n  AND (\n    $4::text IS NULL\n    OR p.patient_name ILIKE '%' || $4 || '%'\n    OR p.whatsapp_number ILIKE '%' || $4 || '%'\n  )\nORDER BY a.start_time;",
        "options": {
          "queryReplacement": "={{ [ $json.date, $json.doctor_id, $json.status, $json.search ] }}"
        }
      },
      "credentials": {
        "postgres": { "id": "POSTGRES_CRED_ID", "name": "Hospital Postgres" }
      }
    },
