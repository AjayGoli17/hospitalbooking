        "jsCode": "const row = $input.first()?.json ?? { today_total: 0, today_scheduled: 0, today_completed: 0, today_cancelled: 0 };\nreturn [{ json: { success: true, statistics: {\n  today_total: row.today_total ?? 0,\n  today_scheduled: row.today_scheduled ?? 0,\n  today_completed: row.today_completed ?? 0,\n  today_cancelled: row.today_cancelled ?? 0\n} } }];"
