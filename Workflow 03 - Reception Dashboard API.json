    {
      "id": "node-normalize",
      "name": "Normalize API Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1160, -60],
      "notes": "Merges GET query params and POST body into one flat shape. route = body.action (POST) or query.resource (GET).",
      "notesInFlow": false,
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst query = item.query || {};\nconst body = item.body || {};\n\nfunction toIntOrNull(v) {\n  if (v === undefined || v === null || v === '') return null;\n  const n = Number(v);\n  return Number.isInteger(n) ? n : null;\n}\n\nfunction toStrOrNull(v) {\n  if (v === undefined || v === null) return null;\n  const s = String(v).trim();\n  return s === '' ? null : s;\n}\n\nconst route = (body && body.action) ? toStrOrNull(body.action) : toStrOrNull(query.resource);\n\nreturn [{ json: {\n  route: route,\n  date: toStrOrNull(query.date),\n  doctor_id: toIntOrNull(query.doctor_id),\n  status: toStrOrNull(query.status),\n  search: toStrOrNull(query.search),\n  appointment_id: toIntOrNull(body.appointment_id),\n  new_status: toStrOrNull(body.status)\n} }];"
      }
    },
