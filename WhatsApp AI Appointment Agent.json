    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO patients (patient_name, whatsapp_number)\nVALUES ($1, $2)\nON CONFLICT (whatsapp_number)\nDO UPDATE SET patient_name = COALESCE(patients.patient_name, EXCLUDED.patient_name)\nRETURNING patient_id, patient_name, whatsapp_number;",
        "options": {
          "queryReplacement": "={{ [$('Extract Webhook Fields').item.json.profileName || null, $('Extract Webhook Fields').item.json.phoneNumber] }}"
        }
