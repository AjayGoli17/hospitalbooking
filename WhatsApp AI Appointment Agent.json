      "id": "8392ea0f-a425-4163-920d-3808ce43a7aa",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1280,
        560
      ],
      "notes": "Select whichever free-tier Gemini model is actually listed in YOUR n8n Gemini credential/model dropdown. Do not assume a model name - pick from the live list.",
      "notesInFlow": false,
