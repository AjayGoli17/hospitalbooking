    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (whatsapp_message_id, phone_number, message_text)\nVALUES ($1, $2, $3)\nON CONFLICT (whatsapp_message_id) DO NOTHING\nRETURNING message_id;",
        "options": {
          "queryReplacement": "={{ [$json.waMessageId, $json.phoneNumber, $json.messageText] }}"
        }
