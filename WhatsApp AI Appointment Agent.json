    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT doctor_id, doctor_name, specialization\nFROM doctors\nWHERE ($1::text IS NULL OR doctor_name ILIKE '%' || $1 || '%')\n  AND ($2::text IS NULL OR specialization ILIKE '%' || $2 || '%');",
        "options": {
          "queryReplacement": "={{ [$fromAI('doctor_name_query','Partial or full doctor name mentioned by patient, or empty string if not given','string'), $fromAI('specialization_query','Specialization mentioned by patient (e.g. cardiologist), or empty string if not given','string')] }}"
        },
        "toolDescription": "Look up doctors by name or specialization. Read-only. Returns 0, 1, or many matches. Never assume a match; report ambiguity or no-match back to the user."
      },
      "id": "a9c7a25f-cd69-472d-a7c8-16b14b9bc41d",
      "name": "Tool - Find Doctor",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1360,
        560
      ],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "Hospital Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS conflict_count\nFROM appointments\nWHERE doctor_id = $1\n  AND status = 'SCHEDULED'\n  AND start_time < $3\n  AND end_time > $2;",
        "options": {
          "queryReplacement": "={{ [$fromAI('doctor_id','Resolved doctor_id from Find Doctor tool','number'), $fromAI('requested_start','Requested appointment start as ISO8601 timestamp with Asia/Kolkata offset','string'), $fromAI('requested_end','Requested appointment end as ISO8601 timestamp with Asia/Kolkata offset','string')] }}"
        },
        "toolDescription": "Check if a doctor has a conflicting SCHEDULED appointment in a time window. Read-only. conflict_count = 0 means free. Never state availability without calling this tool first."
      },
      "id": "af89cb67-5432-46ea-a098-469be357e747",
      "name": "Tool - Check Availability",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1360,
        680
      ],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "Hospital Postgres"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.messageText}}",
        "options": {
          "systemMessage": "You are a hospital appointment assistant for a WhatsApp booking demo.\nAsia/Kolkata is the only timezone. Resolve relative dates (today/tomorrow/evening) against the current date given to you.\n\nYou MUST call the Find Doctor tool before naming any doctor_id.\nYou MUST call the Check Availability tool before ever saying a slot is free or occupied.\nNever invent doctor_id, calendar IDs, availability, or booking success.\nYou cannot book, cancel, or reschedule anything yourself - you only understand the request and report structured findings.\n\nAlways end your turn with ONLY a single JSON object (no prose, no markdown fences) with this exact shape:\n{\n  \"intent\": \"BOOK\" | \"AVAILABILITY_CHECK\" | \"SPECIALIZATION_SEARCH\" | \"MISSING_INFO\" | \"UNSUPPORTED\",\n  \"doctor_name\": string|null,\n  \"specialization\": string|null,\n  \"requested_date\": string|null,\n  \"requested_start_time\": string|null,  // ISO8601 with +05:30 offset\n  \"requested_end_time\": string|null,    // start + 30 min default if not stated\n  \"clarification_question\": string|null,\n  \"reply_text\": string  // natural language reply to send the patient (used only for MISSING_INFO/UNSUPPORTED/SPECIALIZATION_SEARCH-with-no-booking-yet)\n}\nIf required info (doctor OR specialization, AND date, AND time) is missing for a booking or availability question, set intent=MISSING_INFO and ask ONLY for the missing piece(s) in clarification_question.\nIf the user asks for cancellation/rescheduling, set intent=UNSUPPORTED and say this demo does not support that yet."
        }
      },
      "id": "d8f742e4-1d54-4e96-8629-1910e927b75d",
      "name": "Gemini AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1580,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || $input.first().json.text || '';\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { intent: 'UNSUPPORTED', reply_text: 'Sorry, I could not understand that. Could you rephrase?' };\n}\nreturn [{ json: parsed }];"
      },
      "id": "6b47c614-3ae8-4d0b-9751-cb7fccde6f42",
      "name": "Parse Agent Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "output": "={{ $json.intent }}",
        "options": {}
      },
